{
  "name": "xp-commerce-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:bdd": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --import tests/step_definitions/**/*.ts features/**/*.feature",
    "test:bdd:hu1": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --import tests/step_definitions/listar-productos.steps.ts features/productos/listar-productos.feature"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
